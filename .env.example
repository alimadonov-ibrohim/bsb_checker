# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/bsb_checker

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_strong_password
JWT_SECRET=change_this_to_a_long_random_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Payment (optional - leave empty if not configured)
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_CALLBACK_URL=http://localhost:8000/api/payment/callback

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
MAX_FILE_SIZE_MB=50
TEMP_DIR=temp
UPLOADS_DIR=uploads

# Default limits (can be overridden in admin settings)
FREE_DAILY_PDF_LIMIT=3
PREMIUM_DAILY_PDF_LIMIT=6
PREMIUM_PRICE_UZS=35000
PREMIUM_DURATION_DAYS=30

# Vercel / production webhook (optional)
# WEBHOOK_URL=https://your-app.vercel.app
# WEBHOOK_SECRET=random_secret_string
